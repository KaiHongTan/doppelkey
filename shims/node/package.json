{
  "name": "doppelkey",
  "version": "0.1.0",
  "description": "ssh-agent for app secrets: keep signing and encryption keys out of your app's memory (Node shim)",
  "license": "Apache-2.0",
  "type": "commonjs",
  "exports": {
    "./register": {
      "import": "./dist/register.mjs",
      "require": "./dist/register.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "bin": {
    "doppelkey": "bin/doppelkey.js"
  },
  "keywords": [
    "secrets",
    "security",
    "ai-agents",
    "jwt",
    "hmac",
    "webcrypto",
    "ssh-agent",
    "dotenv"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KaiHongTan/doppelkey.git",
    "directory": "shims/node"
  },
  "homepage": "https://github.com/KaiHongTan/doppelkey#readme"
}
